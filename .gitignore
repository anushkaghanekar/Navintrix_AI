# Env
.venv/
.env

# Data & models (too large for git — document how to fetch them instead)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
datasets/*
!datasets/.gitkeep
models/*.pt

# SUMO: generated networks are build outputs (gitignored); XML *sources* and
# the scenario route/configs are committed so scenarios are reproducible.
simulation/scenarios/*.net.xml
!simulation/scenarios/*.nod.xml
!simulation/scenarios/*.edg.xml
!simulation/scenarios/*.add.xml
!simulation/scenarios/*.rou.xml
!simulation/scenarios/*.sumocfg
!simulation/scenarios/.gitkeep

# Experiment outputs (regenerable on a SUMO-capable machine)
evaluation/results/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Frontend
frontend/node_modules/
frontend/dist/

# Misc
.DS_Store
*.log
