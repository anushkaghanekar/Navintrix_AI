<?xml version="1.0" encoding="UTF-8"?>
<!-- Balanced scenario: moderate, roughly even demand on all four approaches. -->
<configuration>
    <input>
        <net-file value="intersection.net.xml"/>
        <route-files value="routes/balanced.rou.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="1"/>
    </time>
    <report>
        <no-step-log value="true"/>
        <no-warnings value="false"/>
    </report>
</configuration>